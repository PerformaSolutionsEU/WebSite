---
// FlowDiagram — hero visual (palette allineata al prodotto Performa Professional).
// Convenzione colore coerente con l'app:
//   - Petrol blue (#1B4D6E): brand, hot path, driver, attività
//   - Emerald (#059669): success semantico — costi unitari di prodotto (risultato positivo del calcolo)
//   - Amber (#D97706): spotlight/focus — outline del nodo evidenziato
//   - Slate: neutrals per risorse, cost object, sfondo

export interface FlowLabels {
  ariaLabel: string;
  caption?: string;
  chromeBg: string;
  chromeFront: string;
  scenarioBadge: string;
  legend: { resource: string; activity: string; costObject: string };
  drivers: { area: string; hours: string; euros: string; pieces: string };
  nodes: {
    building: { label: string; value: string };
    staff: { label: string; value: string };
    depreciation: { label: string; value: string };
    machining: { label: string; value: string };
    assembly: { label: string; value: string };
    productA: { label: string; value: string };
    productB: { label: string; value: string };
    productC: { label: string; value: string };
  };
}

interface Props {
  labels?: FlowLabels;
}

const defaultLabels: FlowLabels = {
  ariaLabel: 'Diagramma di un modello ABC: tre risorse aziendali che alimentano due attività produttive e tre prodotti, con costo unitario calcolato per ciascuno',
  caption: 'Esempio: 3 risorse → 2 attività → 3 prodotti con costo unitario calcolato.',
  chromeBg: 'performa.app  ·  Falegnameria demo  ·  scenario 2025-Q3',
  chromeFront: 'performa.app  ·  Falegnameria demo  ·  € 1.322k allocati',
  scenarioBadge: 'SCENARIO BASELINE ·  PROD A',
  legend: { resource: 'Risorsa', activity: 'Attività', costObject: 'Cost object' },
  drivers: { area: '400 m²', hours: '18k ore', euros: '€ 180k', pieces: '12k pz' },
  nodes: {
    building: { label: 'Edificio', value: '€ 125k · 1.000 m²' },
    staff: { label: 'Personale', value: '€ 946k · 23 FTE' },
    depreciation: { label: 'Ammortamenti', value: '€ 251k' },
    machining: { label: 'Lavorazione', value: '€ 385k · 60k ore' },
    assembly: { label: 'Assemblaggio', value: '€ 240k · 15k ore' },
    productA: { label: 'Prodotto A', value: '€ 18,22 /pz' },
    productB: { label: 'Prodotto B', value: '€ 26,10 /pz' },
    productC: { label: 'Prodotto C', value: '€ 12,80 /pz' },
  },
};

const { labels: labelsProp } = Astro.props;
const labels = labelsProp ?? defaultLabels;
const titleId = `flow-title-${Math.random().toString(36).slice(2, 8)}`;
---

<figure class="flow">
  <div class="flow__bg" aria-hidden="true">
    <div class="flow__chrome flow__chrome--bg">
      <span class="dot dot--r"></span>
      <span class="dot dot--y"></span>
      <span class="dot dot--g"></span>
      <span class="url">{labels.chromeBg}</span>
    </div>
    <div class="flow__bg-body">
      <svg viewBox="0 0 580 240" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <pattern id="dots-bg" width="22" height="22" patternUnits="userSpaceOnUse">
          <circle cx="1.5" cy="1.5" r="1" fill="#94a3b8" opacity="0.14"/>
        </pattern>
        <rect width="580" height="240" fill="url(#dots-bg)"/>
        <g opacity="0.55">
          <rect x="40" y="60" width="120" height="45" rx="8" fill="none" stroke="#94a3b8" stroke-width="1"/>
          <rect x="40" y="130" width="120" height="45" rx="8" fill="none" stroke="#94a3b8" stroke-width="1"/>
          <rect x="230" y="95" width="110" height="45" rx="8" fill="none" stroke="#94a3b8" stroke-width="1"/>
          <rect x="410" y="60" width="110" height="45" rx="8" fill="none" stroke="#94a3b8" stroke-width="1"/>
          <rect x="410" y="130" width="110" height="45" rx="8" fill="none" stroke="#94a3b8" stroke-width="1"/>
          <path d="M160 82 C 195 82, 200 118, 230 118" fill="none" stroke="#94a3b8" stroke-width="1" opacity="0.6"/>
          <path d="M160 152 C 195 152, 200 118, 230 118" fill="none" stroke="#94a3b8" stroke-width="1" opacity="0.6"/>
          <path d="M340 118 C 375 118, 380 82, 410 82" fill="none" stroke="#94a3b8" stroke-width="1" opacity="0.6"/>
          <path d="M340 118 C 375 118, 380 152, 410 152" fill="none" stroke="#94a3b8" stroke-width="1" opacity="0.6"/>
        </g>
      </svg>
    </div>
  </div>

  <div class="flow__frame">
    <div class="flow__chrome" aria-hidden="true">
      <span class="dot dot--r"></span>
      <span class="dot dot--y"></span>
      <span class="dot dot--g"></span>
      <span class="url">{labels.chromeFront}</span>
    </div>

    <svg
      class="flow__svg"
      viewBox="0 0 580 320"
      xmlns="http://www.w3.org/2000/svg"
      role="img"
      aria-labelledby={titleId}
    >
      <title id={titleId}>{labels.ariaLabel}</title>
      <defs>
        <linearGradient id="hot-line" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#1B4D6E" />
          <stop offset="100%" stop-color="#2e7fac" />
        </linearGradient>
        <marker id="arrow-hot" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="5" markerHeight="5" orient="auto">
          <path d="M0,0 L10,5 L0,10 z" fill="#1B4D6E" />
        </marker>
        <marker id="arrow-dim" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="4" markerHeight="4" orient="auto">
          <path d="M0,0 L10,5 L0,10 z" fill="#94a3b8" opacity="0.55" />
        </marker>
        <pattern id="dots" width="22" height="22" patternUnits="userSpaceOnUse">
          <circle cx="1.5" cy="1.5" r="1" class="bg-dot" />
        </pattern>
      </defs>

      <rect width="580" height="320" fill="url(#dots)" />

      <g fill="none" stroke="#94a3b8" stroke-width="1" opacity="0.35" marker-end="url(#arrow-dim)">
        <path d="M170 142 C 200 142, 215 192, 245 192" />
        <path d="M170 227 C 200 227, 215 192, 245 192" />
        <path d="M365 192 C 395 192, 400 57, 430 57" />
        <path d="M365 97 C 395 97, 400 142, 430 142" />
        <path d="M365 97 C 395 97, 400 227, 430 227" />
      </g>

      <g fill="none" stroke="url(#hot-line)" stroke-width="2.6" marker-end="url(#arrow-hot)">
        <path class="hot-anim" d="M170 57 C 200 57, 215 97, 245 97" />
        <path class="hot-anim" d="M170 142 C 200 142, 215 97, 245 97" />
        <path class="hot-anim" d="M170 227 C 205 227, 215 97, 245 97" />
        <path class="hot-anim" d="M365 97 C 395 97, 400 57, 430 57" />
      </g>

      <!-- Driver pill: petrol blue (brand + flow) -->
      <g transform="translate(210 72)">
        <rect x="-26" y="-11" width="52" height="22" rx="6" fill="#1B4D6E"/>
        <text text-anchor="middle" y="4" fill="#ffffff" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="700">{labels.drivers.area}</text>
      </g>
      <g transform="translate(210 122)">
        <rect x="-28" y="-11" width="56" height="22" rx="6" fill="#1B4D6E"/>
        <text text-anchor="middle" y="4" fill="#ffffff" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="700">{labels.drivers.hours}</text>
      </g>
      <g transform="translate(210 175)">
        <rect x="-28" y="-11" width="56" height="22" rx="6" fill="#1B4D6E"/>
        <text text-anchor="middle" y="4" fill="#ffffff" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="700">{labels.drivers.euros}</text>
      </g>
      <g transform="translate(400 68)">
        <rect x="-26" y="-11" width="52" height="22" rx="6" fill="#1B4D6E"/>
        <text text-anchor="middle" y="4" fill="#ffffff" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="700">{labels.drivers.pieces}</text>
      </g>

      <!-- Level 1: risorse (slate neutrals) -->
      <g class="node node--res" transform="translate(30 30)">
        <rect width="140" height="55" rx="8"/>
        <text x="70" y="24" text-anchor="middle" class="node-label">{labels.nodes.building.label}</text>
        <text x="70" y="42" text-anchor="middle" class="node-value">{labels.nodes.building.value}</text>
      </g>
      <g class="node node--res" transform="translate(30 115)">
        <rect width="140" height="55" rx="8"/>
        <text x="70" y="24" text-anchor="middle" class="node-label">{labels.nodes.staff.label}</text>
        <text x="70" y="42" text-anchor="middle" class="node-value">{labels.nodes.staff.value}</text>
      </g>
      <g class="node node--res" transform="translate(30 200)">
        <rect width="140" height="55" rx="8"/>
        <text x="70" y="24" text-anchor="middle" class="node-label">{labels.nodes.depreciation.label}</text>
        <text x="70" y="42" text-anchor="middle" class="node-value">{labels.nodes.depreciation.value}</text>
      </g>

      <!-- Level 2: attività (petrol soft — brand) -->
      <g class="node node--act" transform="translate(245 70)">
        <rect width="120" height="55" rx="8"/>
        <text x="60" y="24" text-anchor="middle" class="node-label">{labels.nodes.machining.label}</text>
        <text x="60" y="42" text-anchor="middle" class="node-value">{labels.nodes.machining.value}</text>
      </g>
      <g class="node node--act" transform="translate(245 165)">
        <rect width="120" height="55" rx="8"/>
        <text x="60" y="24" text-anchor="middle" class="node-label">{labels.nodes.assembly.label}</text>
        <text x="60" y="42" text-anchor="middle" class="node-value">{labels.nodes.assembly.value}</text>
      </g>

      <!-- Level 3: prodotti — emerald prezzi (positive result) + amber highlight su A -->
      <g class="node node--co node--active" transform="translate(430 30)">
        <rect width="120" height="55" rx="8"/>
        <text x="60" y="23" text-anchor="middle" fill="#E2E8F0" font-family="Poppins, sans-serif" font-size="13" font-weight="600">{labels.nodes.productA.label}</text>
        <text x="60" y="43" text-anchor="middle" fill="#10B981" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="700">{labels.nodes.productA.value}</text>
      </g>
      <g class="node node--co" transform="translate(430 115)">
        <rect width="120" height="55" rx="8"/>
        <text x="60" y="23" text-anchor="middle" fill="#E2E8F0" font-family="Poppins, sans-serif" font-size="13" font-weight="600">{labels.nodes.productB.label}</text>
        <text x="60" y="43" text-anchor="middle" fill="#10B981" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="700">{labels.nodes.productB.value}</text>
      </g>
      <g class="node node--co" transform="translate(430 200)">
        <rect width="120" height="55" rx="8"/>
        <text x="60" y="23" text-anchor="middle" fill="#E2E8F0" font-family="Poppins, sans-serif" font-size="13" font-weight="600">{labels.nodes.productC.label}</text>
        <text x="60" y="43" text-anchor="middle" fill="#10B981" font-family="'JetBrains Mono', monospace" font-size="12" font-weight="700">{labels.nodes.productC.value}</text>
      </g>

      <!-- Legenda: attività petrol, prezzo emerald come nel prodotto -->
      <g transform="translate(30 290)">
        <circle cx="6" cy="6" r="4" fill="#94a3b8" opacity="0.6"/>
        <text x="18" y="10" fill="#94a3b8" font-family="'JetBrains Mono', monospace" font-size="10">{labels.legend.resource}</text>
        <circle cx="82" cy="6" r="4" fill="#1B4D6E"/>
        <text x="94" y="10" fill="#94a3b8" font-family="'JetBrains Mono', monospace" font-size="10">{labels.legend.activity}</text>
        <circle cx="152" cy="6" r="4" fill="#0F172A" stroke="#94a3b8" stroke-width="0.8"/>
        <text x="164" y="10" fill="#94a3b8" font-family="'JetBrains Mono', monospace" font-size="10">{labels.legend.costObject}</text>
      </g>

      <g transform="translate(490 15)">
        <text text-anchor="end" fill="#D97706" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="600" letter-spacing="0.05em">{labels.scenarioBadge}</text>
      </g>
    </svg>
  </div>

  {labels.caption && <figcaption class="flow__caption">{labels.caption}</figcaption>}
</figure>

<style lang="scss">
  .flow {
    position: relative;
    margin: 0;
    padding-block-start: 1.25rem;
    padding-inline-end: 1.5rem;
  }

  .flow__bg {
    position: absolute;
    top: 0;
    right: 0;
    left: 2.5rem;
    bottom: 2.5rem;
    background: var(--p-bg-elevated);
    border: 1px solid var(--p-border);
    border-radius: var(--p-radius-xl);
    box-shadow: var(--p-shadow-md);
    overflow: hidden;
    opacity: 0.55;
    z-index: 0;
    pointer-events: none;

    @media (max-width: 720px) {
      left: 1.5rem;
      bottom: 1.5rem;
    }
  }

  .flow__chrome--bg {
    opacity: 0.75;

    .url {
      color: var(--p-fg-subtle);
    }
  }

  .flow__bg-body {
    padding: 0;
  }

  .flow__frame {
    position: relative;
    z-index: 1;
    background: var(--p-bg-elevated);
    border: 1px solid var(--p-border);
    border-radius: var(--p-radius-xl);
    box-shadow: var(--p-shadow-lg);
    overflow: hidden;
  }

  .flow__caption {
    margin-block-start: var(--p-space-4);
    font-family: var(--p-font-mono);
    font-size: var(--p-fs-micro);
    color: var(--p-fg-subtle);
    text-align: center;
    max-width: 32rem;
    margin-inline: auto;
    line-height: 1.5;
  }

  .flow__chrome {
    display: flex;
    align-items: center;
    gap: var(--p-space-2);
    padding: 0.75rem 1rem;
    background: var(--p-bg);
    border-block-end: 1px solid var(--p-border);
    font-family: var(--p-font-mono);
    font-size: 0.75rem;
    color: var(--p-fg-subtle);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 999px;

    &--r { background: #ff5f57; }
    &--y { background: #febc2e; }
    &--g { background: #28c840; margin-inline-end: var(--p-space-4); }
  }

  .url {
    flex: 1;
    text-align: center;
    letter-spacing: 0.02em;
  }

  .flow__svg {
    width: 100%;
    height: auto;
    display: block;

    :global(.bg-dot) {
      fill: #94a3b8;
      opacity: 0.22;
    }

    // Light-mode
    :global(.node--res rect) {
      fill: #ffffff;
      stroke: #cbd5e1;
      stroke-width: 1;
    }
    :global(.node--act rect) {
      fill: #eaf1f5;
      stroke: #1B4D6E;
      stroke-width: 1;
    }
    :global(.node--co rect) {
      fill: #0F172A;
      stroke: #0F172A;
      stroke-width: 1;
    }
    :global(.node--active rect) {
      stroke: #D97706;
      stroke-width: 2.5;
      filter: drop-shadow(0 0 12px rgba(217, 119, 6, 0.4));
    }

    :global(.node-label) {
      font-family: 'Poppins', system-ui, sans-serif;
      font-size: 13px;
      font-weight: 600;
      fill: #0F172A;
    }

    :global(.node-value) {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10.5px;
      fill: #64748B;
    }

    :global(.hot-anim) {
      stroke-dasharray: 320;
      stroke-dashoffset: 0;
      animation: dash 3.2s linear infinite;
    }
  }

  @media (prefers-color-scheme: dark) {
    .flow__svg {
      :global(.bg-dot) {
        fill: #ffffff;
        opacity: 0.09;
      }
      :global(.node--res rect) {
        fill: #1E293B;
        stroke: rgba(255, 255, 255, 0.12);
      }
      :global(.node--act rect) {
        fill: rgba(46, 127, 172, 0.16);
        stroke: #2e7fac;
      }
      :global(.node--co rect) {
        fill: #020617;
        stroke: rgba(255, 255, 255, 0.12);
      }
      :global(.node-label) {
        fill: #E2E8F0;
      }
      :global(.node-value) {
        fill: #94A3B8;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow__svg :global(.hot-anim) {
      animation: none;
    }
  }

  @keyframes dash {
    from { stroke-dashoffset: 320; }
    to   { stroke-dashoffset: 0; }
  }
</style>
