---
// Minimal inline SVG icons (Lucide-style, MIT license style).
// Aggiungere qui i nuovi glifi. Nessuna dipendenza esterna.

interface Props {
  name:
    | 'excel-out'
    | 'network'
    | 'layers'
    | 'factory'
    | 'hotel'
    | 'briefcase'
    | 'heart-pulse'
    | 'shield-check'
    | 'flag-italy'
    | 'sparkles'
    | 'arrow-right'
    | 'check';
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 24, label, class: className } = Astro.props;
const strokeWidth = 1.75;
const attrs = {
  width: size,
  height: size,
  viewBox: '0 0 24 24',
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': strokeWidth,
  'stroke-linecap': 'round' as const,
  'stroke-linejoin': 'round' as const,
  'aria-hidden': label ? undefined : 'true',
  'aria-label': label,
  role: label ? 'img' : undefined,
  class: className,
};
---

{
  name === 'excel-out' && (
    <svg {...attrs}>
      <rect x="3" y="4" width="14" height="16" rx="2" />
      <path d="M3 10h14M9 4v16" />
      <path d="M15 8l6 6M21 8l-6 6" />
    </svg>
  )
}
{
  name === 'network' && (
    <svg {...attrs}>
      <circle cx="6" cy="6" r="2" />
      <circle cx="18" cy="6" r="2" />
      <circle cx="12" cy="18" r="2" />
      <path d="M7.5 7.5l3.5 8.5M16.5 7.5l-3.5 8.5M8 6h8" />
    </svg>
  )
}
{
  name === 'layers' && (
    <svg {...attrs}>
      <path d="M12 3l9 5-9 5-9-5 9-5z" />
      <path d="M3 13l9 5 9-5" />
      <path d="M3 18l9 5 9-5" />
    </svg>
  )
}
{
  name === 'factory' && (
    <svg {...attrs}>
      <path d="M3 21V10l6 4V10l6 4V6l6 4v11H3z" />
      <path d="M7 21v-4M12 21v-4M17 21v-4" />
    </svg>
  )
}
{
  name === 'hotel' && (
    <svg {...attrs}>
      <path d="M3 21h18M4 21V6a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v15" />
      <path d="M9 9h.01M9 13h.01M15 9h.01M15 13h.01M12 21v-4" />
    </svg>
  )
}
{
  name === 'briefcase' && (
    <svg {...attrs}>
      <rect x="3" y="7" width="18" height="13" rx="2" />
      <path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M3 13h18" />
    </svg>
  )
}
{
  name === 'heart-pulse' && (
    <svg {...attrs}>
      <path d="M20.4 12.6L12 21l-8.4-8.4a5.5 5.5 0 0 1 7.8-7.8L12 5.7l.6-.9a5.5 5.5 0 0 1 7.8 7.8z" />
      <path d="M3.8 14h4l2 3 2-6 1.5 3H18" />
    </svg>
  )
}
{
  name === 'shield-check' && (
    <svg {...attrs}>
      <path d="M12 3l8 3v6c0 5-3.5 8.5-8 9-4.5-.5-8-4-8-9V6l8-3z" />
      <path d="M9 12l2 2 4-4" />
    </svg>
  )
}
{
  name === 'flag-italy' && (
    <svg {...attrs}>
      <path d="M4 4v16" />
      <rect x="7" y="4" width="4" height="12" rx="0.5" fill="#009246" stroke="none" />
      <rect x="11" y="4" width="4" height="12" rx="0.5" fill="#ffffff" stroke="none" />
      <rect x="15" y="4" width="4" height="12" rx="0.5" fill="#ce2b37" stroke="none" />
      <rect x="7" y="4" width="12" height="12" rx="0.5" />
    </svg>
  )
}
{
  name === 'sparkles' && (
    <svg {...attrs}>
      <path d="M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5L12 3z" />
      <path d="M19 15l.75 2.25L22 18l-2.25.75L19 21l-.75-2.25L16 18l2.25-.75L19 15z" />
    </svg>
  )
}
{
  name === 'arrow-right' && (
    <svg {...attrs}>
      <path d="M5 12h14M13 6l6 6-6 6" />
    </svg>
  )
}
{
  name === 'check' && (
    <svg {...attrs}>
      <path d="M20 6L9 17l-5-5" />
    </svg>
  )
}
