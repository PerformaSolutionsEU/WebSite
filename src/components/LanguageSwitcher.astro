---
import { getLocale, getAlternatePath, normalizePath, withBase } from '@i18n/routes.mjs';
import { t } from '@i18n/ui.mjs';

const pathname = normalizePath(Astro.url.pathname);
const current = getLocale(pathname);

const itHref = withBase(current === 'it' ? pathname : (getAlternatePath(pathname, 'it') ?? '/'));
const enHref = withBase(current === 'en' ? pathname : (getAlternatePath(pathname, 'en') ?? '/en'));
---

<nav class="lang-switcher" aria-label={t(current, 'lang.switcher.aria')}>
  <a
    href={itHref}
    hreflang="it"
    lang="it"
    aria-current={current === 'it' ? 'true' : undefined}
    class:list={['lang-switcher__link', { 'is-active': current === 'it' }]}
  >
    {t(current, 'lang.it')}
  </a>
  <span class="lang-switcher__sep" aria-hidden="true">·</span>
  <a
    href={enHref}
    hreflang="en"
    lang="en"
    aria-current={current === 'en' ? 'true' : undefined}
    class:list={['lang-switcher__link', { 'is-active': current === 'en' }]}
  >
    {t(current, 'lang.en')}
  </a>
</nav>

<style lang="scss">
  .lang-switcher {
    display: inline-flex;
    align-items: center;
    gap: var(--p-space-2);
    font-size: 0.8125rem;
    line-height: 1;
    color: var(--p-fg-subtle);
  }

  .lang-switcher__link {
    color: var(--p-fg-subtle);
    text-decoration: none;
    padding: var(--p-space-1) var(--p-space-1);
    border-radius: 0.25rem;
    transition: color var(--p-transition);

    &:hover {
      color: var(--p-fg);
      text-decoration: none;
    }

    &:focus-visible {
      outline: 2px solid var(--p-accent);
      outline-offset: 2px;
    }

    &.is-active {
      color: var(--p-fg);
      font-weight: 600;
    }
  }

  .lang-switcher__sep {
    color: var(--p-fg-subtle);
    opacity: 0.5;
  }
</style>
