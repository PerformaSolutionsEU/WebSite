---
import Icon from './Icon.astro';

const signals = [
  { icon: 'flag-italy', label: 'Fatto in Italia' },
  { icon: 'shield-check', label: 'GDPR · Dati in Azure Italia' },
  { icon: 'sparkles', label: 'Copilot AI incluso' },
  { icon: 'check', label: 'Oltre € 300M già allocati in produzione' },
] as const;
---

<section class="trust" aria-label="Segnali di fiducia">
  <div class="container">
    <ul class="trust__list">
      {
        signals.map((s) => (
          <li class="trust__item">
            <Icon name={s.icon} size={18} class="trust__icon" />
            <span>{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style lang="scss">
  .trust {
    padding-block: var(--p-space-6);
    border-block: 1px solid var(--p-border);
    background: var(--p-bg-elevated);
  }

  .trust__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3rem);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .trust__item {
    display: inline-flex;
    align-items: center;
    gap: var(--p-space-2);
    font-size: var(--p-fs-small);
    color: var(--p-fg-muted);
    font-weight: 500;
  }

  .trust__icon {
    color: var(--p-accent);
    flex-shrink: 0;
  }
</style>
