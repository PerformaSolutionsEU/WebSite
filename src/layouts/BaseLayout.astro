---
import '@styles/global.scss';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { getLocale, getAlternatePath, normalizePath, withBase } from '@i18n/routes.mjs';
import { t } from '@i18n/ui.mjs';
import { buildBreadcrumbsLd } from '@i18n/breadcrumbs.mjs';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, canonical, jsonLd, ogImage, noindex } = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://performa.example';
const currentPath = normalizePath(Astro.url.pathname);
const locale = getLocale(currentPath);

// site already includes deploy base (e.g. https://.../WebSite); currentPath is
// base-stripped (e.g. /prodotto) — concat with base prefix to get canonical
const toAbs = (p: string) => `${site}${withBase(p === '/' ? '/' : p)}`;
const canonicalUrl = canonical ?? toAbs(currentPath);
const ogImageUrl = ogImage ?? `${site}${withBase('/og-image.png')}`;

const itPath = getAlternatePath(currentPath, 'it');
const enPath = getAlternatePath(currentPath, 'en');
const alternates: { hreflang: string; href: string }[] = [];
if (itPath) alternates.push({ hreflang: 'it', href: toAbs(itPath) });
if (enPath) alternates.push({ hreflang: 'en', href: toAbs(enPath) });
alternates.push({ hreflang: 'x-default', href: toAbs(itPath ?? currentPath) });

const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Performa',
  url: site,
  description: t(locale, 'seo.org.description'),
};

const breadcrumbsLd = buildBreadcrumbsLd(currentPath, site);
---

<!doctype html>
<html lang={t(locale, 'html.lang')}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />

    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}

    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={t(locale, 'og.locale')} />
    <meta property="og:site_name" content="Performa" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationLd)} />
    {breadcrumbsLd && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsLd)} />
    )}
    {
      jsonLdArray.map((ld) => (
        <script type="application/ld+json" set:html={JSON.stringify(ld)} />
      ))
    }
  </head>
  <body>
    <a href="#main" class="skip-link">{t(locale, 'skip.link')}</a>
    <Header />
    <Breadcrumbs />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
