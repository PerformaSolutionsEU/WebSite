---
import BaseLayout from './BaseLayout.astro';
import PageIntro from '@components/PageIntro.astro';
import { getLocale, normalizePath, withBase } from '@i18n/routes.mjs';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    publishedAt?: string;
    updatedAt?: string;
    articleType?: 'Article' | 'BlogPosting';
    faq?: Array<{ q: string; a: string }>;
    image?: string;
    /**
     * When set, the page renders a PageIntro block (eyebrow + h1 + lead) coherent
     * with the rest of the marketing site. In that case the .mdx body MUST NOT
     * start with an H1 — the H1 is generated from `title`.
     * Set for commercial content (ABC, sector pages); leave undefined for
     * documents (privacy, accessibility).
     */
    eyebrow?: string;
    lead?: string;
  };
}

const { frontmatter } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const inLanguage = locale === 'en' ? 'en-GB' : 'it-IT';

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.performasolutions.eu';
const currentPath = normalizePath(Astro.url.pathname);
const canonicalUrl = `${site}${withBase(currentPath === '/' ? '/' : currentPath)}`;

const baseUrl = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
const siteRoot = site + baseUrl;

// Google Rich Results wants ISO 8601 with timezone — normalize date-only frontmatter to UTC midnight
const toIsoDateTime = (d?: string) => (d ? new Date(d).toISOString() : undefined);

const articleImage = frontmatter.image ?? `${site}${withBase('/og-image.png')}`;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': frontmatter.articleType ?? 'Article',
  headline: frontmatter.title,
  description: frontmatter.description,
  image: articleImage,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
  author: {
    '@type': 'Organization',
    name: 'Performa',
    url: siteRoot,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Performa',
    url: siteRoot,
  },
  datePublished: toIsoDateTime(frontmatter.publishedAt),
  dateModified: toIsoDateTime(frontmatter.updatedAt ?? frontmatter.publishedAt),
  inLanguage,
};

const faqLd = frontmatter.faq && frontmatter.faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      inLanguage,
      mainEntity: frontmatter.faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a,
        },
      })),
    }
  : null;

const layoutJsonLd = faqLd ? [articleLd, faqLd] : articleLd;

const hasIntro = Boolean(frontmatter.eyebrow);
---

<BaseLayout
  title={`${frontmatter.title} — Performa`}
  description={frontmatter.description}
  jsonLd={layoutJsonLd}
>
  {hasIntro ? (
    <>
      <PageIntro
        eyebrow={frontmatter.eyebrow!}
        title={frontmatter.title}
        lead={frontmatter.lead}
      />
      <article class="article-body container">
        <div class="prose">
          <slot />
        </div>
      </article>
    </>
  ) : (
    <article class="article container-narrow">
      <div class="prose">
        <slot />
      </div>
    </article>
  )}
</BaseLayout>

<style>
  /* Documents (privacy, accessibility): reading-mode centered column */
  .article {
    padding-block: var(--p-space-16) var(--p-space-24);
  }

  /* Commercial content (ABC, sector deep-dives): left-aligned body under PageIntro */
  .article-body {
    padding-block: var(--p-space-8) var(--p-space-24);
  }

  .article-body .prose {
    max-width: 44rem;
  }
</style>
