---
import BaseLayout from './BaseLayout.astro';
import { getLocale, normalizePath, withBase } from '@i18n/routes.mjs';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    publishedAt?: string;
    updatedAt?: string;
    articleType?: 'Article' | 'BlogPosting';
    faq?: Array<{ q: string; a: string }>;
  };
}

const { frontmatter } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const inLanguage = locale === 'en' ? 'en-GB' : 'it-IT';

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://performa.example';
const currentPath = normalizePath(Astro.url.pathname);
const canonicalUrl = `${site}${withBase(currentPath === '/' ? '/' : currentPath)}`;

const baseUrl = import.meta.env.BASE_URL === '/' ? '' : import.meta.env.BASE_URL.replace(/\/$/, '');
const siteRoot = site + baseUrl;

// Google Rich Results wants ISO 8601 with timezone — normalize date-only frontmatter to UTC midnight
const toIsoDateTime = (d?: string) => (d ? new Date(d).toISOString() : undefined);

const articleLd = {
  '@context': 'https://schema.org',
  '@type': frontmatter.articleType ?? 'Article',
  headline: frontmatter.title,
  description: frontmatter.description,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
  author: {
    '@type': 'Organization',
    name: 'Performa',
    url: siteRoot,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Performa',
    url: siteRoot,
  },
  datePublished: toIsoDateTime(frontmatter.publishedAt),
  dateModified: toIsoDateTime(frontmatter.updatedAt ?? frontmatter.publishedAt),
  inLanguage,
};

const faqLd = frontmatter.faq && frontmatter.faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      inLanguage,
      mainEntity: frontmatter.faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.a,
        },
      })),
    }
  : null;

const layoutJsonLd = faqLd ? [articleLd, faqLd] : articleLd;
---

<BaseLayout
  title={`${frontmatter.title} — Performa`}
  description={frontmatter.description}
  jsonLd={layoutJsonLd}
>
  <article class="article container-narrow">
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    padding-block: var(--p-space-16) var(--p-space-24);
  }
</style>
