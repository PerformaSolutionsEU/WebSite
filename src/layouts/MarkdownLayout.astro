---
import BaseLayout from './BaseLayout.astro';
import { getLocale } from '@i18n/routes.mjs';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    publishedAt?: string;
    updatedAt?: string;
    articleType?: 'Article' | 'BlogPosting';
  };
}

const { frontmatter } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const inLanguage = locale === 'en' ? 'en-GB' : 'it-IT';

const articleLd = {
  '@context': 'https://schema.org',
  '@type': frontmatter.articleType ?? 'Article',
  headline: frontmatter.title,
  description: frontmatter.description,
  author: {
    '@type': 'Organization',
    name: 'Performa',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Performa',
  },
  datePublished: frontmatter.publishedAt,
  dateModified: frontmatter.updatedAt ?? frontmatter.publishedAt,
  inLanguage,
};
---

<BaseLayout
  title={`${frontmatter.title} — Performa`}
  description={frontmatter.description}
  jsonLd={articleLd}
>
  <article class="article container-narrow">
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    padding-block: var(--p-space-16) var(--p-space-24);
  }
</style>
